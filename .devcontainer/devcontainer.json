{
  "name": "Raylib Virtual Desktop Environment",
  "dockerFile": "Dockerfile",
  "features": {
    // Automatically installs a lightweight fluxbox/noVNC virtual desktop
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "version": "latest",
      "ui.desktop": "fluxbox"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  },
  // Automatically compiles raylib right after the container is created
  "postCreateCommand": "bash .devcontainer/setup-raylib.sh",
  "remoteUser": "vscode"
}